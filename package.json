{
  "name": "patchproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A verification engine for AI-proposed security fixes",
  "bin": {
    "patchproof": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "diff": "8.0.3"
  },
  "scripts": {
    "build": "tsc",
    "build:sandbox": "tsc -p tsconfig.sandbox.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.sandbox.json",
    "sandbox:build": "docker build --file Dockerfile.sandbox --tag patchproof-sandbox:0.1.0 .",
    "bench": "tsx src/cli.ts bench",
    "bench:ci": "tsx src/benchmark/ci.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@types/node": "22.19.0",
    "eslint": "10.13.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
